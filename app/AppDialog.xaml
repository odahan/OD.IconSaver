<Window x:Class="IconSaver.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate x:Key="DescriptionContent">
            <StackPanel>
                <Label Content="_Description (optional, up to 80 characters)" Padding="0"
                       Foreground="{StaticResource MutedBrush}" Target="{Binding ElementName=DescriptionInput}" />
                <TextBox x:Name="DescriptionInput" MaxLength="80" Margin="0,8,0,0" Padding="8,6"
                         Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource BorderBrush}" CaretBrush="{StaticResource TextBrush}"
                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         Loaded="FocusDescription" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="DeleteContent">
            <StackPanel>
                <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                <TextBlock Text="This will permanently delete the selected layout." Margin="0,8,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="AboutContent">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Width="48" Height="48" Source="{Binding Icon}" />
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Version, StringFormat='Version {0}'}"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <Button Content="Buy me A coffee" Click="OpenDonationPage" HorizontalAlignment="Left"
                        Style="{StaticResource ActionButton}" Margin="0,18,0,0" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="RecoveryContent">
            <StackPanel>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0">
                    <Run Text="Icon Saver keeps any unreadable file in this folder." />
                    <LineBreak />
                    <Run Text="%LOCALAPPDATA%\IconSaver" />
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ScreenRestoreContent">
            <StackPanel>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                <ScrollViewer MaxHeight="144" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <ItemsControl ItemsSource="{Binding Details}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="LegacyMatchesContent">
            <StackPanel>
                <TextBlock Text="These icons have the same names as saved icons from an older layout. Their identities could not be verified."
                           TextWrapping="Wrap" />
                <ScrollViewer MaxHeight="144" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <ItemsControl ItemsSource="{Binding}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Background="{StaticResource WindowBrush}">
        <Border DockPanel.Dock="Top" Height="42" Style="{StaticResource TitleBar}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource CaptionCloseButton}" Click="CloseWindow"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <ContentPresenter Content="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                  ContentTemplate="{StaticResource TitleBarContent}" />
            </DockPanel>
        </Border>
        <StackPanel Margin="24">
            <ContentControl x:Name="DialogContent" />
            <TextBlock x:Name="DonationError" Visibility="Collapsed" Margin="0,10,0,0"
                       Text="Could not open the donation page in your browser." TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="CancelButton" Content="_Cancel" IsCancel="True" MinWidth="84" Margin="0,8,0,0"
                        Style="{StaticResource ActionButton}" />
                <Button x:Name="ExactMatchesButton" Content="_Exact matches only" Click="AcceptExactMatches"
                        Style="{StaticResource ActionButton}" Visibility="Collapsed" Margin="8,8,0,0" />
                <Button x:Name="AcceptButton" Click="Accept" MinWidth="84" Margin="8,8,0,0"
                        Style="{StaticResource ActionButton}" Background="{StaticResource AccentBrush}"
                        Foreground="#14102C" BorderBrush="{StaticResource AccentBrush}" />
            </WrapPanel>
        </StackPanel>
    </DockPanel>
</Window>
