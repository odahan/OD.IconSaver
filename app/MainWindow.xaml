<Window x:Class="IconSaver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Icon Saver" Icon="IconSaver.ico" Width="690" Height="570" MinWidth="540" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="WindowSurface" Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource TitleBar}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" AutomationProperties.Name="Minimize" ToolTip="Minimize" Click="MinimizeWindow">
                        <Path Data="M 0,5 H 10" Stroke="{StaticResource TextBrush}" />
                    </Button>
                    <Button x:Name="ResizeButton" Style="{StaticResource CaptionButton}" AutomationProperties.Name="Maximize"
                            ToolTip="Maximize" Click="ToggleMaximizeWindow">
                        <Path x:Name="ResizeGlyph" Data="M 0,0 H 9 V 9 H 0 Z" Stroke="{StaticResource TextBrush}" />
                    </Button>
                    <Button Style="{StaticResource CaptionCloseButton}" Click="CloseWindow" />
                </StackPanel>
                <ContentPresenter Content="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                  ContentTemplate="{StaticResource TitleBarContent}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="29,24,29,21">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="Desktop icon layouts" FontWeight="SemiBold" FontSize="28" />
                <TextBlock Text="Save your icon positions and restore them whenever you need to."
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,15" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="_Save current layout" Command="{Binding SaveCommand}" Background="{StaticResource AccentBrush}"
                            Foreground="#14102C" BorderBrush="{StaticResource AccentBrush}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NeedsRecovery}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Recover _history" Command="{Binding RecoverCommand}"
                            Style="{StaticResource ActionButton}" Background="{StaticResource AccentBrush}"
                            Foreground="#14102C" BorderBrush="{StaticResource AccentBrush}"
                            Visibility="{Binding NeedsRecovery, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="14,11">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="4,0,4,8">
                        <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                   Text="{Binding HistoryCount}" VerticalAlignment="Center" />
                        <TextBlock Text="Saved layouts" FontWeight="SemiBold" FontSize="16" />
                    </DockPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout}"
                             AutomationProperties.Name="Saved layouts" ItemContainerStyle="{StaticResource LayoutRow}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding IconCountText}"
                                               Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" />
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding DisplayName}" />
                                    <TextBlock Text="{Binding Description}"
                                               Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="1" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowEmptyHistory}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="No saved layouts yet" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Save your current layout to add it here." Foreground="{StaticResource MutedBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                    <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="_Restore selected" Command="{Binding RestoreCommand}"
                                Style="{StaticResource ActionButton}" />
                        <Button DockPanel.Dock="Right" Content="_Delete selected" Command="{Binding DeleteCommand}"
                                Style="{StaticResource ActionButton}" Margin="0,0,8,0" />
                        <TextBlock Text="Newest first" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" Margin="4,0,12,0" />
                    </DockPanel>
                </Grid>
            </Border>

            <DockPanel Grid.Row="2" Margin="0,13,0,0">
                <Button DockPanel.Dock="Right" Content="_About" Click="ShowAbout"
                        MinHeight="28" Padding="11,4" Margin="12,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"
                           MinHeight="20" Foreground="{StaticResource MutedBrush}"
                           AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
